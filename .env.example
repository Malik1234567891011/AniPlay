# Copy to .env and fill in. .env is gitignored.

# Image generation (spec §19, §32.6). Without it the app uses placeholder art.
OPENAI_API_KEY=

# Text generation (spec §17.7). Without it the rule-based pipeline runs.
ANTHROPIC_API_KEY=

# Where generated art is served from. Unset means the client draws placeholders.
MEDIA_CDN_BASE_URL=http://localhost:4000/media
