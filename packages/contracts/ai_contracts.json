{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project ANIMA AI Contracts",
  "version": "1.0.0",
  "$defs": {
    "EntityRef": {
      "type": "object",
      "required": [
        "entityType",
        "entityId"
      ],
      "properties": {
        "entityType": {
          "enum": [
            "player",
            "npc",
            "item",
            "location",
            "ability",
            "quest",
            "faction",
            "environment"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ActionIntent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "intentId",
        "rawAction",
        "actions",
        "dialogue",
        "confidence",
        "ambiguities"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "intentId": {
          "type": "string"
        },
        "rawAction": {
          "type": "string",
          "maxLength": 4000
        },
        "dialogue": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "speaker",
              "text",
              "visibility"
            ],
            "properties": {
              "speaker": {
                "$ref": "#/$defs/EntityRef"
              },
              "text": {
                "type": "string"
              },
              "visibility": {
                "enum": [
                  "SELF",
                  "PAIR_PRIVATE",
                  "NPC_PRIVATE",
                  "GROUP",
                  "WORLD"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "verb",
              "actor",
              "targets",
              "method",
              "declaredOutcome",
              "timeIntent"
            ],
            "properties": {
              "verb": {
                "enum": [
                  "move",
                  "speak",
                  "persuade",
                  "deceive",
                  "threaten",
                  "inspect",
                  "use_item",
                  "use_ability",
                  "attack",
                  "defend",
                  "hide",
                  "steal",
                  "interact",
                  "travel",
                  "rest",
                  "help",
                  "oppose",
                  "wait",
                  "custom"
                ]
              },
              "actor": {
                "$ref": "#/$defs/EntityRef"
              },
              "targets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/EntityRef"
                }
              },
              "method": {
                "type": "string"
              },
              "declaredOutcome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "abilityId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "itemId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeIntent": {
                "enum": [
                  "NOW",
                  "AFTER",
                  "DURING",
                  "UNTIL",
                  "UNSPECIFIED"
                ]
              },
              "visibility": {
                "enum": [
                  "SELF",
                  "PAIR_PRIVATE",
                  "NPC_PRIVATE",
                  "GROUP",
                  "WORLD"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsafeOrMetaRequests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CheckResult": {
      "type": "object",
      "required": [
        "checkId",
        "label",
        "attribute",
        "dc",
        "rolls",
        "keptRoll",
        "modifier",
        "total",
        "margin",
        "outcome"
      ],
      "properties": {
        "checkId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "dc": {
          "type": "integer"
        },
        "advantageLevel": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "rolls": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "keptRoll": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "modifier": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "margin": {
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "CRITICAL_SUCCESS",
            "CLEAN_SUCCESS",
            "SUCCESS",
            "SUCCESS_WITH_COST",
            "FAILURE",
            "COMPLICATION"
          ]
        }
      },
      "additionalProperties": false
    },
    "StateMutation": {
      "type": "object",
      "required": [
        "mutationId",
        "type",
        "subjectId",
        "reasonCode",
        "payload"
      ],
      "properties": {
        "mutationId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "RESOURCE_DELTA",
            "ITEM_ADD",
            "ITEM_REMOVE",
            "ITEM_UPDATE",
            "RELATIONSHIP_DELTA",
            "QUEST_TRANSITION",
            "FACTION_DELTA",
            "STATUS_ADD",
            "STATUS_REMOVE",
            "LOCATION_CHANGE",
            "TIME_ADVANCE",
            "ABILITY_UNLOCK",
            "XP_DELTA",
            "LEVEL_CHANGE",
            "FLAG_SET",
            "ENCOUNTER_START",
            "ENCOUNTER_UPDATE",
            "ENCOUNTER_END"
          ]
        },
        "subjectId": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "Resolution": {
      "type": "object",
      "required": [
        "schemaVersion",
        "turnId",
        "valid",
        "normalizedActions",
        "checks",
        "mutations",
        "observableFacts",
        "privateFacts",
        "timeAdvancedMinutes",
        "newOpportunities",
        "rngSeedHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "turnId": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "invalidReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalizedActions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckResult"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateMutation"
          }
        },
        "observableFacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privateFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "visibility",
              "fact"
            ],
            "properties": {
              "visibility": {
                "type": "string"
              },
              "fact": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "timeAdvancedMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "newOpportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rngSeedHash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "BeatPlan": {
      "type": "object",
      "required": [
        "schemaVersion",
        "dramaticFocus",
        "beatType",
        "orderedBeats",
        "speakerOrder",
        "reveals",
        "suggestedActions",
        "mediaPlan",
        "memoryProposals",
        "arcUpdates",
        "wordBudget"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "dramaticFocus": {
          "type": "string"
        },
        "beatType": {
          "enum": [
            "DIALOGUE",
            "ACTION",
            "CHECK",
            "COMBAT",
            "REVEAL",
            "TRANSITION",
            "REST",
            "CLIFFHANGER",
            "MONTAGE"
          ]
        },
        "orderedBeats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "factIds",
              "instruction"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "NARRATION",
                  "DIALOGUE",
                  "STATE_REVEAL",
                  "CHECK_REVEAL",
                  "QUEST_UPDATE",
                  "SCENE_TRANSITION"
                ]
              },
              "factIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "instruction": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "speakerOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reveals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedActions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "text",
              "intentHint"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 180
              },
              "intentHint": {
                "type": "string"
              },
              "risk": {
                "enum": [
                  "SAFE",
                  "UNCERTAIN",
                  "RISKY",
                  "EXTREME"
                ]
              },
              "resourceCostLabel": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "mediaPlan": {
          "$ref": "#/$defs/MediaPlan"
        },
        "memoryProposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryProposal"
          }
        },
        "arcUpdates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "wordBudget": {
          "type": "integer",
          "minimum": 20,
          "maximum": 500
        }
      },
      "additionalProperties": false
    },
    "NarrativeTurn": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sceneSummary",
        "blocks",
        "stateDeltaPresentation",
        "endStatePrompt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "sceneSummary": {
          "type": "string",
          "maxLength": 320
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "type",
              "text",
              "visibility"
            ],
            "properties": {
              "type": {
                "enum": [
                  "NARRATION",
                  "DIALOGUE",
                  "SYSTEM"
                ]
              },
              "speakerId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 1200
              },
              "visibility": {
                "enum": [
                  "SELF",
                  "PAIR_PRIVATE",
                  "NPC_PRIVATE",
                  "GROUP",
                  "WORLD"
                ]
              },
              "voiceEligible": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "stateDeltaPresentation": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "mutationId",
              "label",
              "priority"
            ],
            "properties": {
              "mutationId": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "additionalProperties": false
          }
        },
        "endStatePrompt": {
          "type": "string",
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "MemoryProposal": {
      "type": "object",
      "required": [
        "subjectId",
        "predicate",
        "value",
        "visibility",
        "importance",
        "sourceEventIds"
      ],
      "properties": {
        "subjectId": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "value": {},
        "visibility": {
          "enum": [
            "WORLD_PUBLIC",
            "FACTION",
            "PARTY",
            "NPC_PRIVATE",
            "PLAYER_PRIVATE",
            "PAIR_PRIVATE",
            "CREATOR_ONLY"
          ]
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceEventIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedesFactId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "MediaPlan": {
      "type": "object",
      "required": [
        "stageAction",
        "activeCharacterIds",
        "expressions",
        "heroImage",
        "voice",
        "sfx",
        "musicCue"
      ],
      "properties": {
        "stageAction": {
          "enum": [
            "KEEP",
            "CHANGE_LOCATION",
            "CHANGE_VARIANT"
          ]
        },
        "activeCharacterIds": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "expressions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "heroImage": {
          "type": "object",
          "required": [
            "eligible",
            "reason",
            "shotType"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "shotType": {
              "enum": [
                "NONE",
                "ESTABLISHING",
                "PORTRAIT",
                "TWO_SHOT",
                "ACTION",
                "REVEAL",
                "BOSS",
                "MOMENT"
              ]
            }
          },
          "additionalProperties": false
        },
        "voice": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "blockIndex",
              "voiceId"
            ],
            "properties": {
              "blockIndex": {
                "type": "integer",
                "minimum": 0
              },
              "voiceId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "musicCue": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ConsistencyReport": {
      "type": "object",
      "required": [
        "valid",
        "violations"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "description"
            ],
            "properties": {
              "code": {
                "enum": [
                  "UNSUPPORTED_STATE",
                  "INVENTORY_CONTRADICTION",
                  "LOCATION_CONTRADICTION",
                  "DEAD_ENTITY_SPEAKS",
                  "KNOWLEDGE_LEAK",
                  "RELATIONSHIP_GATE_BYPASS",
                  "QUEST_CONTRADICTION",
                  "NAME_IDENTITY_DRIFT",
                  "SAFETY",
                  "FORMAT"
                ]
              },
              "severity": {
                "enum": [
                  "WARN",
                  "ERROR"
                ]
              },
              "description": {
                "type": "string"
              },
              "blockIndex": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}