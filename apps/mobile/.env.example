# Copy to apps/mobile/.env. Expo inlines EXPO_PUBLIC_* at build time, so
# everything here is public and none of it may be a secret.

# Where the API is. A simulator can reach localhost; a device cannot.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Supabase → Project Settings → API. The anon key is designed to be public.
# Without these the app plays as a device-local guest and the sign-in sheet
# says so instead of offering sign-in that cannot work.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the privacy policy and terms are published. Without it the links are
# hidden rather than pointed at nothing, and App Store review will ask for them.
EXPO_PUBLIC_LEGAL_BASE_URL=
